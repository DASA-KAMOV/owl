debug/
target/

# VS Code
.vscode/

# Built Visual Studio Code Extensions
*.vsix

# Can be generated by other build systems other than cargo (ex: bazelbuild/rust_rules) 
rust-project.json

# Debug Symbols
*.pdb

# Backup files generated by rustfmt
**/*.rs.bk

# Log files
*.log

# IDE specific files
.idea/
*.suo
*.user
*.tmp
*.bak

# Operating system files
node_modules/
.DS_Store
Thumbs.db
/images/Thumbs.db:encryptable

# Test files
test/